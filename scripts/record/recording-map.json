          "feedback": "本次选择 Gemini 3 Pro Image 与 GPT Image 2",
          "recordability": "ready"
        },
        {
          "name": "发起真实评测",
          "selector": "button:has-text('发起评测')",
          "action": "click",
          "feedback": "创建新 Run，并显示运行中、部分结果与终态",
          "waitFor": ".arena-results-page",
          "recordability": "ready"
        }
      ]
    }
  ],
  "features": [
