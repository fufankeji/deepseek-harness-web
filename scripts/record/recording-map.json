          "action": "type",
          "feedback": "工作区事实卡变为已就绪",
          "recordability": "ready"
        },
        {
          "name": "信任项目资源",
          "selector": "button:has-text('信任项目资源')",
          "action": "click",
          "feedback": "访问权限变为信任项目资源",
          "recordability": "ready"
        }
      ]
    },
    {
      "path": "/workbench",
