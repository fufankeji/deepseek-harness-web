    },
    {
      "key": "journey-live-model-evaluation",
      "name": "双模型真实生图评测",
      "entry": {
        "route": "http://127.0.0.1:3001/#/arena",
        "selector": ".arena-v2-page"
      },
      "steps": [
        "展开 V4 Pro 新增的公平评测说明",
